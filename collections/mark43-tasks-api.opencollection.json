{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mark43 Partnerships Associated Records Tasks API",
    "version": "external"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve tasks (Tasks)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{department}.mark43.com/partnerships/api/partnerships/api/external/tasks"
          },
          "docs": "Retrieve tasks (Tasks)"
        },
        {
          "info": {
            "name": "Create/submit tasks (Tasks)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{department}.mark43.com/partnerships/api/partnerships/api/external/tasks"
          },
          "docs": "Create/submit tasks (Tasks)"
        }
      ]
    }
  ],
  "bundled": true
}