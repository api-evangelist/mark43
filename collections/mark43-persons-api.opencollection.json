        {
          "info": {
            "name": "Create/submit merge with criteria (Persons)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{department}.mark43.com/partnerships/api/partnerships/api/external/person/merge_with_criteria"
