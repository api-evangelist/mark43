{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mark43 Partnerships Associated Records Persons API",
    "version": "external"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Persons",
        "type": "folder"
      },
      "items": [
