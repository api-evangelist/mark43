{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mark43 Partnerships Associated Records Attachments API",
    "version": "external"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Attachments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve attachments (Attachments)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{department}.mark43.com/partnerships/api/partnerships/api/external/attachments/"
          },
          "docs": "Retrieve attachments (Attachments)"
        },
        {
          "info": {
            "name": "Create/submit files (Attachments)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{department}.mark43.com/partnerships/api/partnerships/api/external/attachments/files"
          },
          "docs": "Create/submit files (Attachments)"
        },
        {
          "info": {
            "name": "Create/submit images (Attachments)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{department}.mark43.com/partnerships/api/partnerships/api/external/attachments/images"
          },
          "docs": "Create/submit images (Attachments)"
        },
        {
          "info": {
            "name": "Create/submit search (Attachments)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{department}.mark43.com/partnerships/api/partnerships/api/external/attachments/search"
          },
          "docs": "Create/submit search (Attachments)"
        },
        {
          "info": {
            "name": "Retrieve stream (Attachments)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{department}.mark43.com/partnerships/api/partnerships/api/external/attachments/stream/"
          },
          "docs": "Retrieve stream (Attachments)"
        }
      ]
    }
  ],
  "bundled": true
}